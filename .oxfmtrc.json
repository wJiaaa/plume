{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": true,
  "printWidth": 160,
  "sortPackageJson": false,
  "overrides": [
    {
      "files": ["*.json", "*.jsonc"],
      "options": { "useTabs": false, "tabWidth": 2 }
    }
  ],
  "ignorePatterns": ["packages/core/llm/**", "pnpm-lock.yaml", "**/*.md"]
}
