{
  "name": "@plume/spawn-session",
  "version": "0.1.0",
  "description": "让模型另开会话：你提了新的事时先问「新会话 / 就在这里做」，你要求单开时当场开，它自己发现的事只放一张建议卡；做到一半可以移交出去。开出来的会话每结束一轮都把汇报交回来。你要它做完就归档时，这一轮收场后归档这个对话。",
  "author": "Plume",
  "keywords": [
    "会话",
    "建议",
    "spawn_session",
    "hand_off_to_session",
    "archive_session"
  ],
  "plume": {
    "displayName": "开新会话",
    "category": "工作流"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@plumeai/plugin-sdk": "workspace:*",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "react": "^19.3.1",
    "vitest": "^5.1.0"
  }
}
