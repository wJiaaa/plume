{
  "name": "@plume/secrets",
  "version": "0.1.0",
  "description": "把插件的密钥（令牌、密码、请求头里的凭据）加密成一段文本，作为服务 secrets 给别的插件用；钥匙只在这台机器上。",
  "author": "Plume",
  "plume": {
    "displayName": "密钥加密"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "devDependencies": {
    "@plumeai/plugin-sdk": "workspace:*",
    "@types/node": "^24.10.0"
  }
}
