  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@plumeai/plugin-sdk": "workspace:*",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0"
  }
