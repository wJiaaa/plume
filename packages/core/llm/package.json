    },
    "./prefix-fingerprint": {
      "types": "./dist/ai/prefix-fingerprint.d.ts",
      "default": "./src/ai/prefix-fingerprint.ts"
    },
    "./vendors": {
      "types": "./dist/ai/vendors/index.d.ts",
      "default": "./src/ai/vendors/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.10.0"
