    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./src/types.ts"
    },
    "./failure": {
      "types": "./dist/ai/failure.d.ts",
      "default": "./src/ai/failure.ts"
    },
    "./retry-policy": {
      "types": "./dist/config/retry-policy.d.ts",
      "default": "./src/config/retry-policy.ts"
    },
    "./thinking-options": {
      "types": "./dist/ai/thinking-options.d.ts",
      "default": "./src/ai/thinking-options.ts"
    },
    "./endpoint": {
      "types": "./dist/ai/endpoint.d.ts",
      "default": "./src/ai/endpoint.ts"
    },
    "./cache-routing": {
      "types": "./dist/ai/cache-routing.d.ts",
      "default": "./src/ai/cache-routing.ts"
    },
    "./image-models": {
      "types": "./dist/config/image-models.d.ts",
      "default": "./src/config/image-models.ts"
    },
    "./images": {
      "types": "./dist/images/generate.d.ts",
      "default": "./src/images/generate.ts"
