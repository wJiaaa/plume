{
  // 插件继承这一份：`"extends": "@plume/plugin-sdk/tsconfig.json"`。
  // paths 把宿主的公开接口指到 SDK 生成的声明上（路径相对这个文件），插件的写法和仓库里的一样。
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@plume/contract": ["./dist/contract/src/index.d.ts"],
      "@plume/contract/ui": ["./dist/contract/src/ui.d.ts"],
      "@plume/ui": ["./dist/ui.d.ts"],
      "@plume/ui/icons": ["./dist/client/ui/src/icons/index.d.ts"],
      "@plume/styles": ["./dist/client/styles/src/index.d.ts"]
    }
  }
}
