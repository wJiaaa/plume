{
  "name": "@plumeai/plugin-sdk",
  "version": "0.1.3",
  "description": "写 Plume 插件用的类型、命令（新建、检查、构建、安装）、插件模板和给 agent 的 skill。随 Plume 应用带一份，也发在 npm 上（插件仓库按版本依赖）。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wJiaaa/plume.git",
    "directory": "packages/sdk/plugin-sdk"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "plume-plugin": "./bin/plume-plugin.mjs"
  },
  "exports": {
    "./tsconfig.json": "./tsconfig.json",
    "./build": "./lib/build.mjs",
    "./lint": "./lib/lint/index.mjs",
    "./manifest": "./lib/manifest.mjs",
    "./targets": "./lib/targets.mjs"
  },
  "scripts": {
    "typecheck": "node scripts/build-types.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.68.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@plume/contract": "workspace:*",
    "@plume/llm": "workspace:*",
    "@plume/rpc": "workspace:*",
    "@plume/styles": "workspace:*",
    "@plume/ui": "workspace:*",
    "@types/react-dom": "^19.2.0"
  }
}
